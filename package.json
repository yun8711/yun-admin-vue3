{
  "name": "yun-admin-vue3",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "stylelint": "stylelint \"**/*.{css,scss,vue}\"",
    "stylelint:fix": "stylelint \"**/*.{css,scss,vue}\" --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.13.5",
    "element-plus": "^2.13.2",
    "lodash-es": "^4.17.23",
    "pinia": "^2.3.1",
    "vue": "^3.5.29",
    "vue-router": "^4.6.4",
    "yun-elp": "^1.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^10.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.3.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "code-inspector-plugin": "^1.4.2",
    "eslint": "^10.0.2",
    "eslint-plugin-oxlint": "^1.50.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "postcss-html": "^1.8.1",
    "sass": "^1.97.3",
    "stylelint": "^17.3.0",
    "stylelint-config-clean-order": "^8.0.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^7.0.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.56.1",
    "unocss": "^66.6.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^6.4.1",
    "vue-tsc": "^2.2.12"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "oxfmt",
      "oxlint",
      "eslint --fix"
    ],
    "*.{css,scss,vue}": [
      "stylelint --fix"
    ]
  },
  "browserslist": [
    "chrome >= 91",
    "firefox >= 90",
    "edge >= 91"
  ],
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ]
  }
}
