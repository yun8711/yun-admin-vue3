{
  "name": "yun-admin-vue3",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "commit": "czg",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "stylelint": "stylelint \"**/*.{css,scss,vue}\"",
    "stylelint:fix": "stylelint \"**/*.{css,scss,vue}\" --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@voerkai18n/runtime": "^3.0.22",
    "@voerkai18n/vue": "^3.0.22",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "element-plus": "^2.14.2",
    "lodash-es": "^4.18.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "yun-elp": "^1.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@commitlint/types": "^21.1.0",
    "@eslint/js": "^10.0.1",
    "@iconify-json/ep": "^1.2.4",
    "@iconify/utils": "^3.1.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.0.0",
    "@unocss/preset-rem-to-px": "^66.7.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@voerkai18n/cli": "^3.0.22",
    "@voerkai18n/vite": "^2.1.13",
    "code-inspector-plugin": "^1.6.2",
    "eslint": "^10.5.0",
    "eslint-plugin-oxlint": "^1.71.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "postcss-html": "^1.8.1",
    "postcss-rtlcss": "^6.0.0",
    "sass": "^1.101.0",
    "stylelint": "^17.13.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "unocss": "^66.7.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.0",
    "vite-plugin-qiankun": "^1.0.15",
    "vue-tsc": "^3.3.5"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "oxfmt",
      "oxlint",
      "eslint --fix"
    ],
    "*.{css,scss,vue}": [
      "stylelint --fix"
    ]
  },
  "browserslist": [
    "chrome >= 91",
    "firefox >= 90",
    "edge >= 91"
  ],
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ]
  }
