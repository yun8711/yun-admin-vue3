{
  "name": "rhea",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite dev",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vue-tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview",
    "i18n:extract": "voerkai18n extract",
    "i18n:compile": "voerkai18n compile",
    "commit": "czg",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "stylelint": "stylelint \"**/*.{css,scss,vue}\"",
    "stylelint:fix": "stylelint \"**/*.{css,scss,vue}\" --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@voerkai18n/runtime": "^2.1.13",
    "@voerkai18n/vue": "^2.1.13",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "lodash-es": "^4.18.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "yun-elp": "^1.10.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@iconify-json/ep": "^1.2.4",
    "@iconify/utils": "^3.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.3",
    "@unocss/preset-rem-to-px": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@voerkai18n/cli": "^2.1.13",
    "@voerkai18n/vite": "^2.1.13",
    "code-inspector-plugin": "^1.6.6",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.56.0",
    "postcss-html": "^2.0.0",
    "postcss-rtlcss": "^6.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.105.0",
    "stylelint": "^17.15.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.1",
    "vite-plugin-qiankun": "^1.0.15",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "oxfmt",
      "eslint --fix"
    ],
    "*.{css,scss,vue}": [
      "stylelint --fix"
    ]
  },
  "browserslist": [
    "chrome >= 91",
    "firefox >= 90",
    "edge >= 91"
  ],
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "core-js",
      "core-js-pure",
      "es5-ext",
      "esbuild",
      "fsevents",
      "vue-demi"
    ]
  }
}
