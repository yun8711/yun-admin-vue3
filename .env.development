# 所有请求统一追加的前缀（可选）
VITE_APP_BASE_API=/api
# 是否跳过菜单权限校验（开发环境默认 true，全部路由可见无需后端）
VITE_APP_SKIP_MENU_AUTH=true
# 应用标题（浏览器标签页）
VITE_APP_TITLE=Yun Admin
# 前端项目启动时的端口
VITE_APP_FE_PORT=8026
# 开发环境后端代理地址（仅 vite dev 生效）
VITE_APP_PROXY_TARGET=http://192.168.122.130
# 多后端前缀列表，逗号分隔，可选端口
# 格式：前缀[:端口]。未指定端口时使用 VITE_APP_PROXY_TARGET 的默认端口
VITE_APP_API_PREFIXES=/rhea,/daas,/indicator,/poseidon,/label
# 开发环境代理后缀（dev 下请求 /rhea/xxx -> /rhea_dev/xxx 命中代理）
VITE_APP_DEV_PROXY_SUFFIX=_dev
# 是否启用 qiankun 子应用模式（开发环境默认 false，可改为 true 调试）
VITE_QIANKUN_ENABLED=false
