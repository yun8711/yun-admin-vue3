# Vite 环境变量示例：
# 开发环境默认读取 .env.development，生产环境默认读取 .env.production。

VITE_APP_BASE_API=/api
# 可选：请求层默认配置（不填则使用代码内默认值）
# VITE_APP_RES_PATH=data
# VITE_APP_ERROR_PATH=data
# 所有请求统一追加的前缀（可选）
# VITE_APP_API_PREFIX=
# 多后端前缀列表，逗号分隔（如 /rhea,/indicator）
# VITE_APP_API_PREFIXES=
# 开发环境代理后缀（如 /rhea -> /rhea2）
# VITE_APP_DEV_PROXY_SUFFIX=2
# 是否跳过菜单权限校验：
#   模板默认 true（全部异步路由可见，无需后端即可运行）；
#   生产置 false，从后端菜单接口按 menuKey 过滤动态路由。
VITE_APP_SKIP_MENU_AUTH=true
# 应用标题（浏览器标签页）
VITE_APP_TITLE=Yun Admin
# 前端项目启动时的端口
VITE_APP_FE_PORT=8026

# 开发环境后端代理地址（仅 vite dev 生效，由 vite.config.ts 的 server.proxy 使用）
VITE_APP_PROXY_TARGET=http://192.168.122.130
